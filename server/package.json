{
  "name": "server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "db:reset": "tsx scripts/resetDb.ts",
    "db:reset-candidates": "tsx scripts/resetCandidates.ts",
    "db:purge-fixtures": "tsx scripts/purgeTestFixtures.ts",
    "e2e": "tsx scripts/run-e2e.ts",
    "e2e:serve": "cross-env SEED_DEMO=1 node dist/src/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
