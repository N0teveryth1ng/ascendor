# Server
PORT=5174
HOST=127.0.0.1

# Postgres (Neon). Required — there is no local file fallback.
# Use the POOLED connection string for runtime and migrations alike; the
# serverless driver multiplexes over it, so a single URL is all that is needed.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Fixed accounts (production). With FIXED_ACCOUNTS=1 the candidate roster is
# exactly two people and POST /api/auth/signup returns 403, so no third account
# can be created. Passwords are read only from the environment — there is no
# committed default, and startup logs an error if any of these are missing.
# ─────────────────────────────────────────────────────────────────────────────
# FIXED_ACCOUNTS=1
# CANDIDATE_ONE_EMAIL=
# CANDIDATE_ONE_PASSWORD=
# CANDIDATE_ONE_NAME=
# CANDIDATE_TWO_EMAIL=
# CANDIDATE_TWO_PASSWORD=
# CANDIDATE_TWO_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Demo accounts (local dev / CI only). Creates billi / anik / teacher@forge.local
# with the well-known passwords below. Never enable on a shared or public
# environment: the teacher account has admin access to every candidate.
# ─────────────────────────────────────────────────────────────────────────────
# SEED_DEMO=1
# DEMO_PASSWORD_BILLI=billi-demo-2024
# DEMO_PASSWORD_ANIK=anik-demo-2024
# DEMO_PASSWORD_TEACHER=teacher-demo-2024
