# Server
PORT=5174
HOST=127.0.0.1

# SQLite file. Must live on a persistent, writable volume in production.
FORGE_DB_PATH=./data/forge.db

# Opt-in demo accounts (billi / anik / teacher@forge.local).
# Leave UNSET in any shared or public environment: these are well-known
# credentials and the teacher account has admin access to every candidate.
# SEED_DEMO=1
#
# Override individual demo passwords instead of trusting the committed ones:
# DEMO_PASSWORD_BILLI=
# DEMO_PASSWORD_ANIK=
# DEMO_PASSWORD_TEACHER=
