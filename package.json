{
  "name": "forge-v2",
  "private": true,
  "version": "2.0.0",
  "description": "THE FORGE v2 — Adaptive High-Rigor Language Acquisition System",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web && npm run typecheck:api",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test": "npm run test --workspace server",
    "audit:promises": "node scripts/audit-floating-promises.mjs",
    "smoke": "npm run smoke --workspace server",
    "verify": "npm run typecheck && npm run test && npm run audit:promises && npm run build",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
